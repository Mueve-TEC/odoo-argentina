<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Vista Form para el Wizard de Ajuste por Inflación -->
    <record id="inflation_adjustment_wizard_view_form" model="ir.ui.view">
        <field name="name">inflation.adjustment.wizard.form</field>
        <field name="model">inflation.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajuste por Inflación">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,preview,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Ajuste por Inflación Contable</h1>
                        <h3>Cierre de Ejercicio Fiscal</h3>
                    </div>

                    <!-- Advertencias -->
                    <div class="alert alert-warning" role="alert" invisible="not warning_message">
                        <field name="warning_message" readonly="1" nolabel="1" />
                    </div>

                    <!-- Configuración Principal (solo en draft) -->
                    <group invisible="state != 'draft'">
                        <group string="Período del Ejercicio">
                            <field name="company_id" options="{'no_create': True}" />
                            <field name="currency_id" invisible="1" />
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                        <group string="Índices de Inflación">
                            <field name="start_index_id" readonly="1" />
                            <field name="start_index" readonly="1" />
                            <field name="end_index_id" readonly="1" />
                            <field name="end_index" readonly="1" />
                            <field name="adjustment_factor" readonly="1" widget="percentage"
                                options="{'factor': 1}" />
                        </group>
                    </group>

                    <group invisible="state != 'draft'">
                        <group string="Configuración del Asiento">
                            <field name="journal_id" options="{'no_create': True}" />
                            <field name="result_account_id" options="{'no_create': True}"
                                placeholder="Cuenta RECPAM" />
                        </group>
                        <group string="Asientos de Cierre/Apertura">
                            <field name="has_closure_entries" widget="radio" />
                            <field name="closure_move_id" invisible="has_closure_entries == 'no'"
                                required="has_closure_entries == 'yes'"
                                options="{'no_create': True}" />
                            <field name="opening_move_id" invisible="has_closure_entries == 'no'"
                                options="{'no_create': True}" />
                        </group>
                    </group>

                    <!-- Vista Previa de Líneas (solo en preview) -->
                    <div invisible="state != 'preview'">
                        <separator string="Vista Previa de Líneas de Ajuste" />
                        <field name="preview_line_ids" nolabel="1" readonly="1">
                            <list string="Líneas de Ajuste" editable="bottom" create="false"
                                delete="false">
                                <field name="account_id" />
                                <field name="period" />
                                <field name="original_balance" sum="Total Original" />
                                <field name="factor" />
                                <field name="adjustment_amount" sum="Total Ajuste" />
                                <field name="is_initial" invisible="1" />
                            </list>
                        </field>
                    </div>

                    <!-- Información adicional -->
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        <strong>Información:</strong>
                        <p>
                            Este wizard genera el asiento de ajuste por inflación según la normativa
                            argentina
                            (RT 6, RT 17, RT 48). El ajuste se aplica a las cuentas marcadas con el
                            tag
                            "Non Monetary" (cuentas no monetarias).
                        </p>
                        <p>
                            <strong>Cuentas No Monetarias:</strong> Bienes de uso, inversiones
                            permanentes, patrimonio neto, resultados (ingresos y gastos). </p>
                        <p>
                            <strong>Cuenta RECPAM:</strong> El resultado del ajuste se registra en
                            la cuenta "Resultado por Exposición a los Cambios en el Poder
                            Adquisitivo de la Moneda". </p>
                    </div>
                </sheet>

                <footer invisible="state == 'done'">
                    <button name="action_preview" string="Vista Previa" type="object"
                        class="btn-primary" invisible="state != 'draft'" />
                    <button name="action_back_to_draft" string="Volver" type="object"
                        invisible="state != 'preview'" />
                    <button name="action_confirm" string="Generar Asiento" type="object"
                        class="btn-primary" invisible="state != 'preview'" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el Wizard -->
    <record id="action_inflation_adjustment_wizard" model="ir.actions.act_window">
        <field name="name">Generar Ajuste por Inflación</field>
        <field name="res_model">inflation.adjustment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="inflation_adjustment_wizard_view_form" />
        <field name="target">new</field>
    </record>

</odoo>
