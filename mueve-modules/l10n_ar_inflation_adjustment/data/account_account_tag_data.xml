<?xml version="1.0" encoding="utf-8"?>
<!--
    Tag para identificar cuentas no monetarias (ajustables por inflación)

    Según RT 6 y RT 17, las cuentas no monetarias son aquellas que no
    representan moneda de curso legal ni derechos/obligaciones en moneda.

    Ejemplos de cuentas NO MONETARIAS (se ajustan):
    - Bienes de uso (activos fijos)
    - Inversiones permanentes
    - Intangibles
    - Inventarios (en algunos casos)
    - Patrimonio neto
    - Resultados (ingresos y gastos)

    Ejemplos de cuentas MONETARIAS (NO se ajustan):
    - Caja y bancos
    - Créditos por ventas
    - Deudas comerciales y financieras
    - Previsiones
-->
<odoo noupdate="0">

    <!-- Tag para identificar cuentas no monetarias -->
    <record id="non_monetary_account_tag" model="account.account.tag">
        <field name="name">No Monetaria (Ajustable por Inflación)</field>
        <field name="applicability">accounts</field>
        <field name="country_id" ref="base.ar" />
    </record>

</odoo>
