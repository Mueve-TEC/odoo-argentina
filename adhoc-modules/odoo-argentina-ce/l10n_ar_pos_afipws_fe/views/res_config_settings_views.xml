<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_l10n_ar_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ar.pos.afipws.fe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']" position="after">
                <setting
                    string="Invoice by default"
                    id="l10n_ar_pos_invoice_by_default"
                    help="When enabled, every new order is marked as 'To invoice' by default. The cashier can still turn the toggle off on the payment screen.">
                    <field name="pos_l10n_ar_default_to_invoice"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
