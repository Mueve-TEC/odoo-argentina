<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_l10n_ar_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ar.point.of.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_invoice_journal_id']/parent::div" position="after">
                <div class="row"
                     title="When enabled, every new order is marked as 'To invoice' by default. The cashier can still turn the toggle off on the payment screen.">
                    <label string="Invoice by default" for="pos_l10n_ar_default_to_invoice" class="col-lg-3 o_light_label"/>
                    <field name="pos_l10n_ar_default_to_invoice"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
