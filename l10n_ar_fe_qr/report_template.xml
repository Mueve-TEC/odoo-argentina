<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<template id="qr_report_invoice_document" inherit_id="account.report_invoice_document">
			<xpath expr="//div[hasclass('page')]" position="after">
				<div class="footer" style="border: 1px solid black; margin-top: 20px;">
					<div class="row"
						style="margin-bottom: 0px !important; padding-top: 3px; padding-bottom: 3px;">
						<div class="col-4" t-if="o.afip_cae">
							<p />
							<p>
								<strong> CAE: </strong>
								<span t-field="o.afip_cae" />
							</p>
							<p>
								<strong> Fecha Vencimiento CAE: </strong>
								<span t-field="o.afip_cae_due" />
							</p>
						</div>
						<div class="col-2" t-if="o.texto_modificado_qr">
							<p />
							<strong>Codigo QR: </strong>
						</div>
						<div class="col-6" t-if="o.texto_modificado_qr">
							<img
								t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', o.texto_modificado_qr, 180, 180)"
								style="width:185px;height:185px" />
						</div>
					</div>
				</div>
			</xpath>
		</template>


	</data>
</odoo>